---
import { site } from '../data/site';
---

<header class="nav">
  <div class="wrap nav-in">
    <a class="brand" href="#top"><span class="brand-mark">&lt;/&gt;</span> {site.name}</a>
    <nav class="nav-links" id="navlinks">
      {site.nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a
      class="btn btn-whatsapp nav-cta"
      href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hi ${site.name}, I'd like to talk about a project.`)}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.01 2C6.48 2 2 6.48 2 12.01c0 1.99.58 3.85 1.58 5.42L2 22l4.7-1.53a9.96 9.96 0 0 0 5.31 1.53h.01c5.52 0 10-4.48 10-10.01C22.01 6.48 17.53 2 12.01 2Zm5.8 14.3c-.24.68-1.4 1.3-1.93 1.36-.5.06-1.02.28-3.43-.72-2.9-1.2-4.76-4.13-4.9-4.32-.14-.2-1.17-1.56-1.17-2.98 0-1.42.74-2.11 1-2.4.26-.29.57-.36.77-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.82 2 .89 2.15.07.15.12.32.02.52-.1.2-.15.32-.3.49-.14.17-.3.38-.43.5-.14.14-.29.29-.13.57.17.29.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.34 1.44.29.14.46.12.63-.07.17-.2.72-.84.92-1.13.19-.29.38-.24.65-.14.26.1 1.68.79 1.97.94.29.14.48.21.55.33.07.12.07.7-.17 1.38Z"/></svg>
      WhatsApp
    </a>
    <button class="burger" id="burger" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
  </div>
</header>
